# Supabase project settings → API
# Both of these are public: the anon key is safe in the browser because RLS
# restricts what it can read and write.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Used by scripts/import-leads.mjs to bypass RLS for bulk
# upserts. Never put this in wrangler.jsonc `vars` and never expose it to the
# browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
